# Dispcam environment configuration
# Copy this file to .env.local and fill in the values.

# --- Supabase (Postgres database — replaces Firebase Firestore) ---
# Get these from: Supabase Dashboard → Project Settings → API
#   URL:     Project URL  (https://<project-ref>.supabase.co)
#   anon key: "anon" public key (safe for client-side use, RLS protects data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare R2 (photo storage — replaces Firebase Storage) ---
# URL of the deployed upload Worker, from `cd workers && npx wrangler deploy`
# (e.g. https://dispcam-upload.<your-subdomain>.workers.dev)
NEXT_PUBLIC_R2_WORKER_URL=

# Optional: public custom domain bound to the R2 bucket (e.g. https://media.example.com).
# When set, photos load from plain public URLs instead of signed Worker URLs.
NEXT_PUBLIC_MEDIA_BASE_URL=
